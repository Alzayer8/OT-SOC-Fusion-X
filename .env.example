# OT-SOC Fusion X local development values only. Never reuse in production.
APP_NAME=OT-SOC Fusion X
APP_VERSION=1.1.1
APP_ENV=development
API_VERSION=v1
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

POSTGRES_USER=otsoc
POSTGRES_PASSWORD=CHANGE_ME_PHASE9B_LOCAL_ONLY
POSTGRES_DB=otsoc
POSTGRES_TEST_DB=otsoc_test
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://otsoc:CHANGE_ME_PHASE9B_LOCAL_ONLY@localhost:5432/otsoc
TEST_DATABASE_URL=postgresql+psycopg://otsoc:CHANGE_ME_PHASE9B_LOCAL_ONLY@localhost:5432/otsoc_test
DATABASE_CONNECT_TIMEOUT_SECONDS=2

# Generate a unique value locally (for example with Python's secrets.token_urlsafe).
# The literal placeholder is rejected and must never be used as a working secret.
AUTH_SESSION_SECRET=CHANGE_ME_V1_1_LOCAL_ONLY
AUTH_SESSION_TTL_MINUTES=480
AUTH_COOKIE_SECURE=false
AUTH_SESSION_COOKIE_NAME=otsoc_session
AUTH_CSRF_COOKIE_NAME=otsoc_csrf
SCENARIO_LAB_STARTUP_ENABLED=true

BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_BASE_URL=
VITE_PROXY_TARGET=http://backend:8000
